# Copiar para /etc/painel-gxtv-v2.env (chmod 600). Nunca commitar senhas.
PAINEL_USER=gustavo
# Login próprio fica em /var/lib/painel-gxtv-v2/auth.json (cópia única do hash do v1).
# Deixe PAINEL_PASSWORD vazio para usar esse arquivo. Não aponte o login para o auth do v1.
PAINEL_V2_AUTH_FILE=/var/lib/painel-gxtv-v2/auth.json
PAINEL_PASSWORD=
PAINEL_V2_SECURE_COOKIE=0
# Em staging local:
# PAINEL_V2_DEV_AUTH=1  (aceita senha "dev")
# PAINEL_V2_SEED=1      (exemplos de estado)
GESTOR_BASE=https://gestor-iptv-1.emergent.host
GESTOR_CACHE_PATH=/var/cache/painel-gxtv-v2/gestor.json
GESTOR_KPI_CACHE_PATH=/var/cache/painel-gxtv-v2/gestor_kpis.json
# Listagens oficiais (/api/expiring/*, /api/manager/*) pedem Bearer:
# GESTOR_BEARER=
# ou GESTOR_EMAIL= + GESTOR_PASSWORD=
LIVE_LOG=/opt/mnrobo/atendimento/ai/private/live.log
WEBHOOK_QUEUE=/opt/mnrobo/atendimento/webhook/queue.jsonl
# Opcional. Sem isto, o v2 lê o JSON diário do /contagem em
# PAINEL_CONTADOR_DIR/cache/AAAA-MM-DD.json (o mesmo cache do painel atual).
# CONTAGEM_COMPLETA=/var/lib/painel-gxtv/contagem_completa.json
# PAINEL_CONTADOR_DIR=/opt/mnrobo/contador_tg
ESPERANDO_MIN=15
PAINEL_V2_DIST=/opt/painel-gxtv-v2/frontend/dist
# Opcional: confiar cookie de sessão do v1
# PAINEL_V1_TRUST_SESSION=1
# PAINEL_V1_SESSION_COOKIE=session
