# Incluir no server{} do painel atual (NÃO substitui a raiz).
# Painel v1 continua em / ; v2 em /v2 e /api/v2.

location /api/v2/ {
    proxy_pass http://127.0.0.1:8787/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
    # SSE (log ao vivo F2)
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    chunked_transfer_encoding off;
}

location /v2/assets/ {
    proxy_pass http://127.0.0.1:8787/v2/assets/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    expires 7d;
    add_header Cache-Control "public";
}

location /v2 {
    proxy_pass http://127.0.0.1:8787/v2;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
}
